# Publisher config loaded by server/ota_publisher_thermopile.py via python-dotenv.
# Copy this file to server/publisher.env (keep it git-ignored) and fill it in.

# --- Required ---

# Local code folder(s) to pack and ship. Comma-separated for multiple paths.
REPO_PATHS=<absolute/path/to/prod/folder>

# Device group this push targets. Used in the archive filename and appended
# to MQTT_BASE_TOPIC to form the publish topic (<MQTT_BASE_TOPIC>/<DEVICE_GROUP>).
# Uncomment one; keep the others commented.
DEVICE_GROUP=thermopile
# DEVICE_GROUP=thermophile
# DEVICE_GROUP=THERMOPILECHE2

MQTT_BROKER=<broker-host-or-ip>
MQTT_PORT=<broker-port>
MQTT_USERNAME=<mqtt-username>
MQTT_PASSWORD=<mqtt-password>
MQTT_BASE_TOPIC=ota/updates

# --- Optional (defaults shown) ---

# Archive base name: <ARCHIVE_BASENAME>-<DEVICE_GROUP>-<timestamp>.tar.gz
# ARCHIVE_BASENAME=repo_bundle

# Chunk size in bytes (default 262144 = 256 KB)
# CHUNK_SIZE=262144

# MQTT QoS (0, 1, 2). Default 1.
# QOS=1

# Retain the manifest on the broker (true/false). Default false.
# RETAIN_MANIFEST=false
