# Publisher config loaded by server/ota_publisher_thermopile.py via python-dotenv.
# Copy this file to server/publisher.env (keep it git-ignored) and fill it in.

# --- Required ---

# Local code folder(s) to pack and ship. Comma-separated for multiple paths.
REPO_PATHS=C:/Users/HP/Downloads/AZ Chennai 11June/AZ Chennai/Desk/prod

# Branch tag. Used in the archive filename and appended to MQTT_BASE_TOPIC
# to form the publish topic (<MQTT_BASE_TOPIC>/<BRANCH>).
BRANCH=thermopile

MQTT_BROKER=172.28.26.11
MQTT_PORT=8883
MQTT_USERNAME=AZCHE_MQTT
MQTT_PASSWORD=change-me
MQTT_BASE_TOPIC=ota/updates

# --- Optional (defaults shown) ---

# Archive base name: <ARCHIVE_BASENAME>-<BRANCH>-<timestamp>.tar.gz
# ARCHIVE_BASENAME=repo_bundle

# Where to keep the built tar.gz. Unset = temp dir.
# OUTPUT_DIR=C:/Users/HP/Desktop/github

# Chunk size in bytes (default 262144 = 256 KB)
# CHUNK_SIZE=262144

# MQTT QoS (0, 1, 2). Default 1.
# QOS=1

# Retain the manifest on the broker (true/false). Default false.
# RETAIN_MANIFEST=false
